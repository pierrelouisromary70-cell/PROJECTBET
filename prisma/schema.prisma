// RunnerBet schema — SQLite/Prisma
// Models couvrent : auth, profils coureurs, PRs certifiés, courses, paris, boutique, pubs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============== AUTH / USERS ==============

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  displayName   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Économie virtuelle
  tokens        Int      @default(100)

  // Strava
  stravaId           String? @unique
  stravaAccessToken  String?
  stravaRefreshToken String?
  stravaExpiresAt    Int?

  // Réputation / anti-triche
  trustScore    Int      @default(50) // 0-100

  // Parrainage
  referralCode      String   @unique
  referredById      String?
  referredBy        User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals         User[]   @relation("Referrals")
  referralFirstPRDone   Boolean @default(false)
  referralFirstBetDone  Boolean @default(false)

  // Engagement
  lastDailyBonusAt  DateTime?
  loginStreak       Int      @default(0)

  // Anti-fraude
  emailVerified     Boolean  @default(false)
  emailVerifyToken  String?  @unique
  banned            Boolean  @default(false)
  banReason         String?

  // Identification unique par téléphone (E.164, ex +33612345678)
  phoneE164         String?  @unique
  phoneVerified     Boolean  @default(false)
  phoneVerifyCode   String?
  phoneVerifyExpiresAt DateTime?

  profile       RunnerProfile?
  prs           PersonalRecord[]   @relation("UserPRs")
  prVotes       PRVote[]
  bets          Bet[]
  inventory     InventoryItem[]
  adViews       AdView[]
  tokenLogs     TokenLog[]
  achievements  Achievement[]
  purchases     TokenPurchase[]

  racesCreated  Race[]             @relation("RaceCreator")
  raceEntriesA  RaceEntry[]        @relation("RaceEntryRunner")

  challenges    Challenge[]        @relation("ChallengeOwner")
  challengeBets ChallengeBet[]

  duelsAsChallenger Duel[]  @relation("DuelChallenger")
  duelsAsOpponent   Duel[]  @relation("DuelOpponent")
  duelBets          DuelBet[]

  clubMember        ClubMember?
  clubsCaptained    Club[]   @relation("ClubCaptain")
  warContributions  ClubWarContribution[]
}

model RunnerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender      String   // "M" | "F" | "X"
  birthYear   Int
  city        String?

  // VDOT courant (recalculé à chaque PR vérifié)
  vdot        Float    @default(30)

  // Avatar — corps
  avatarSeed  String   @default("base")
  skinTone    String   @default("medium") // light | lightMedium | medium | darkMedium | dark

  // Avatar — équipement
  equippedShoes   String?
  equippedShirt   String?
  equippedShorts  String?
  equippedSocks   String?
  equippedCap     String?
  equippedGlasses String?
  equippedWatch   String?
  equippedBelt    String?

  // Titre affiché à côté du pseudo (code d'achievement)
  selectedTitle   String?

  loadouts Loadout[]
}

model Loadout {
  id        String   @id @default(cuid())
  profileId String
  profile   RunnerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  shoesId   String?
  shirtId   String?
  shortsId  String?
  socksId   String?
  capId     String?
  glassesId String?
  watchId   String?
  beltId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, name])
}

// ============== CHRONOS CERTIFIÉS ==============

model PersonalRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserPRs", fields: [userId], references: [id], onDelete: Cascade)

  distanceM   Int      // distance en mètres (5000, 10000, 21097, 42195, etc.)
  timeSec     Int      // chrono en secondes
  raceDate    DateTime

  source      String   // "STRAVA" | "MANUAL" | "OFFICIAL"
  evidenceUrl String?  // lien résultat officiel ou photo dossard
  stravaActivityId String? @unique

  status      String   @default("PENDING") // PENDING | VERIFIED | REJECTED
  verifiedAt  DateTime?

  votes       PRVote[]

  createdAt   DateTime @default(now())

  @@index([userId, distanceM])
}

model PRVote {
  id      String  @id @default(cuid())
  prId    String
  pr      PersonalRecord @relation(fields: [prId], references: [id], onDelete: Cascade)
  voterId String
  voter   User    @relation(fields: [voterId], references: [id], onDelete: Cascade)
  approve Boolean
  createdAt DateTime @default(now())

  @@unique([prId, voterId])
}

// ============== COURSES & PARIS ==============

model Race {
  id          String   @id @default(cuid())
  name        String
  distanceM   Int
  scheduledAt DateTime
  location    String?
  status      String   @default("OPEN") // OPEN | CLOSED | SETTLED
  creatorId   String
  creator     User     @relation("RaceCreator", fields: [creatorId], references: [id])

  entries     RaceEntry[]
  bets        Bet[]

  createdAt   DateTime @default(now())
}

model RaceEntry {
  id        String  @id @default(cuid())
  raceId    String
  race      Race    @relation(fields: [raceId], references: [id], onDelete: Cascade)
  runnerId  String
  runner    User    @relation("RaceEntryRunner", fields: [runnerId], references: [id], onDelete: Cascade)
  finishSec Int?    // renseigné après course
  position  Int?

  @@unique([raceId, runnerId])
}

model Bet {
  id          String   @id @default(cuid())
  raceId      String
  race        Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)
  bettorId    String
  bettor      User     @relation(fields: [bettorId], references: [id], onDelete: Cascade)

  // Pari binaire : qui gagne entre A et B
  runnerAId   String
  runnerBId   String
  pickedId    String   // celui sur qui on parie
  stake       Int
  oddsX100    Int      // cote *100 figée à la prise du pari (ex 185 = 1.85)

  status      String   @default("OPEN") // OPEN | WON | LOST | VOID
  payout      Int      @default(0)
  settledAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([raceId, status])
}

// ============== BOUTIQUE ==============

model ShopItem {
  id          String   @id // slug stable
  category    String   // shoes|shirt|shorts|socks|cap|glasses|watch|belt
  brand       String
  model       String
  tier        String   // entry|mid|premium|carbon|limited
  priceTokens Int
  imageEmoji  String   // pour l'avatar simple
  description String

  // Édition limitée : si renseigné, l'item disparaît de la boutique à cette date
  availableUntil DateTime?

  inventory   InventoryItem[]
}

model InventoryItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  item      ShopItem @relation(fields: [itemId], references: [id])
  acquiredAt DateTime @default(now())

  @@unique([userId, itemId])
}

// ============== ECONOMIE ==============

model AdView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchedAt DateTime @default(now())
  tokensEarned Int

  @@index([userId, watchedAt])
}

model TokenLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String   // BET_STAKE, BET_PAYOUT, AD_REWARD, PURCHASE, SIGNUP_BONUS, PR_VERIFIED_BONUS, REFERRAL_*, DAILY_STREAK, ACHIEVEMENT
  ref       String?  // id de l'objet associé
  createdAt DateTime @default(now())
}

// ============== ACHIEVEMENTS ==============

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String   // voir lib/achievements.ts
  unlockedAt DateTime @default(now())

  @@unique([userId, code])
}

// ============== ACHATS DE JETONS ==============

model TokenPurchase {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack         String    // slug du pack
  tokens       Int       // jetons (incl. bonus)
  amountCents  Int       // prix payé en centimes
  currency     String    @default("EUR")
  provider     String    // STRIPE | DEMO
  providerRef  String?   // session id côté provider
  status       String    @default("PENDING") // PENDING | COMPLETED | FAILED
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([userId, status])
}

// ============== DÉFIS QUOTIDIENS ==============
// Un coureur crée un défi sur lui-même, les autres parient YES/NO sur sa
// réussite. Résolution par Strava ou preuve manuelle, expiration auto.

model Challenge {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation("ChallengeOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  kind        String   // TIME | LONG_RUN | VOLUME | STREAK
  description String   // texte généré, ex "10 km sub 50:00"

  // Paramètres (selon kind) ; un champ peut être null si non utilisé.
  targetDistanceM Int?
  targetTimeSec   Int?
  targetTotalKm   Float?
  targetDays      Int?

  // Probabilité estimée et cote initiale (à la création).
  // probSuccess = probabilité APRÈS application de la confiance (utilisée pour les cotes).
  // probRaw     = probabilité brute du modèle (avant shrinkage).
  // confidence  = score de confiance dans les données du créateur (0..1).
  probSuccess Float
  probRaw     Float    @default(0.5)
  confidence  Float    @default(0.5)
  oddsYesX100 Int
  oddsNoX100  Int

  // Plafond de mise par parieur (dépend de la confiance).
  maxBetStake Int      @default(5000)

  // Mise du créateur — il parie automatiquement YES.
  ownerStake  Int

  // Délai
  startAt     DateTime @default(now())
  deadline    DateTime
  resolvedAt  DateTime?
  status      String   @default("OPEN") // OPEN | RESOLVED_YES | RESOLVED_NO | EXPIRED | VOID
  evidenceUrl String?

  bets        ChallengeBet[]
  createdAt   DateTime @default(now())

  @@index([status, deadline])
}

model ChallengeBet {
  id          String   @id @default(cuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  bettorId    String
  bettor      User     @relation(fields: [bettorId], references: [id], onDelete: Cascade)

  side        String   // YES | NO
  stake       Int
  oddsX100    Int      // figée à la prise
  isOwner     Boolean  @default(false)

  status      String   @default("OPEN") // OPEN | WON | LOST | VOID
  payout      Int      @default(0)
  settledAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([challengeId, status])
}

// ============== DUELS 1v1 ==============
// Deux coureurs se défient directement sur une même métrique. Ils s'engagent
// avec la même mise (pot = 2 × stake). Les spectateurs parient en plus.

model Duel {
  id              String   @id @default(cuid())
  challengerId    String
  challenger      User     @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId      String
  opponent        User     @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  kind            String   // FASTEST_TIME (chrono sur distance) | LONG_RUN (sortie la plus longue) | VOLUME (km cumulés)
  targetDistanceM Int?     // pour FASTEST_TIME et LONG_RUN
  deadline        DateTime

  // Confiance moyenne au moment de la création (sert au plafond des paris spectateurs)
  confidence      Float    @default(0.5)

  // Cotes initiales basées sur les VDOT — figées à l'acceptation.
  oddsChallengerX100 Int   @default(200)
  oddsOpponentX100   Int   @default(200)
  maxBetStake     Int      @default(2000)

  stakePerSide    Int
  pot             Int      @default(0) // alimenté par les deux mises

  status          String   @default("PROPOSED") // PROPOSED | OPEN | RESOLVED_CHALLENGER | RESOLVED_OPPONENT | DRAW | CANCELED | EXPIRED
  acceptedAt      DateTime?
  resolvedAt      DateTime?

  challengerResult Int?    // selon kind : secondes pour FASTEST_TIME, mètres pour LONG_RUN/VOLUME
  opponentResult   Int?
  challengerEvidence String?
  opponentEvidence String?

  bets            DuelBet[]
  createdAt       DateTime @default(now())

  @@index([status, deadline])
}

model DuelBet {
  id        String   @id @default(cuid())
  duelId    String
  duel      Duel     @relation(fields: [duelId], references: [id], onDelete: Cascade)
  bettorId  String
  bettor    User     @relation(fields: [bettorId], references: [id], onDelete: Cascade)

  pickedId  String   // challenger ou opponent
  stake     Int
  oddsX100  Int

  status    String   @default("OPEN") // OPEN | WON | LOST | VOID
  payout    Int      @default(0)
  settledAt DateTime?
  createdAt DateTime @default(now())

  @@index([duelId, status])
}

// ============== CLUBS ==============

model Club {
  id          String   @id @default(cuid())
  name        String   @unique
  tag         String   @unique // 3-5 chars, type [RUN]
  emoji       String   @default("🏃")
  description String?
  captainId   String
  captain     User     @relation("ClubCaptain", fields: [captainId], references: [id])
  treasury    Int      @default(0)
  joinPolicy  String   @default("OPEN") // OPEN | INVITE_ONLY
  warsAttack  ClubWar[] @relation("WarClubA")
  warsDefend  ClubWar[] @relation("WarClubB")
  members     ClubMember[]
  createdAt   DateTime @default(now())
}

model ClubMember {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String   @unique  // un user dans 1 seul club à la fois
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // CAPTAIN | OFFICER | MEMBER
  warPoints Int      @default(0)        // cumul du war courant
  joinedAt  DateTime @default(now())

  @@index([clubId])
}

// ============== GUERRE DE CLUBS ==============

model ClubWar {
  id           String   @id @default(cuid())
  clubAId      String
  clubA        Club     @relation("WarClubA", fields: [clubAId], references: [id])
  clubBId      String
  clubB        Club     @relation("WarClubB", fields: [clubBId], references: [id])

  startAt      DateTime @default(now())
  endAt        DateTime
  stakePerSide Int
  pot          Int      @default(0)
  status       String   @default("PROPOSED") // PROPOSED | ACTIVE | RESOLVED | CANCELED
  acceptedAt   DateTime?
  resolvedAt   DateTime?
  winnerId     String?

  scoreA       Int      @default(0)
  scoreB       Int      @default(0)
  contributions ClubWarContribution[]

  @@index([status])
}

model ClubWarContribution {
  id        String   @id @default(cuid())
  warId     String
  war       ClubWar  @relation(fields: [warId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId    String   // camp
  source    String   // CHALLENGE_WIN | DUEL_WIN | PR_VERIFIED | ACTIVITY_KM
  sourceRef String?
  points    Int
  createdAt DateTime @default(now())

  @@index([warId, clubId])
}
